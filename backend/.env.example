# ==============================================================================
# AI Resume Screener - Environment Configuration Template
# ==============================================================================
# Copy this file to .env to configure your local runtime:
#   cp .env.example .env
#
# Defaults follow a local-first, fail-closed privacy architecture.
# ==============================================================================

# Database URL
# Defaults to local SQLite file at backend/data/app.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/resumescreener
# DATABASE_URL=sqlite:///data/app.db

# Storage Directory for Staged Resumes
# Defaults to backend/data/staged_resumes
# RESUME_STORAGE_DIR=backend/data/staged_resumes

# Upload Limits (bytes)
# MAX_FILE_SIZE_BYTES=15728640        # 15 MB per file
# MAX_BATCH_SIZE_BYTES=314572800      # 300 MB per batch

# Local Embedding Provider (Local Ollama nomic-embed-text)
# Runs 100% locally on your machine at http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM Provider (Disabled by default)
# All generative AI features require explicit authorization.
# LLM_PROVIDER=disabled
# OLLAMA_LLM_ENABLED=false
# OLLAMA_MODEL_NAME=gpt-oss:120b-cloud
# OLLAMA_CLOUD_USAGE_AUTHORIZED=false
